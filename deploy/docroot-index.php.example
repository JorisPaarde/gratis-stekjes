<?php

/**
 * Voorbeeld van de index.php die deploy in de docroot zet.
 * Paden komen uit secrets (APP_DIR / STAGING_APP_DIR) — dit bestand
 * wordt niet zelf gedeployd; de workflow genereert het.
 */
define('LARAVEL_START', microtime(true));

// Placeholder: absoluut pad naar de private app-map (buiten de webroot)
require '/path/to/app/vendor/autoload.php';

/** @var \Illuminate\Foundation\Application $app */
$app = require_once '/path/to/app/bootstrap/app.php';

// Docroot = deze map (__DIR__), zodat asset() en Vite build/ manifest kloppen
$app->usePublicPath(__DIR__);

$app->handleRequest(Illuminate\Http\Request::capture());
