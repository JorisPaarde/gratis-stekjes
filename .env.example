APP_NAME="Gratis planten"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# staging/productie: default secure via config; lokaal false.
# SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# Laravel 12: smtps (SSL/poort 465) of smtp (STARTTLS/poort 587). Geen Resend.
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
# Bij Hoasted: gelijk aan MAIL_USERNAME (mailbox).
# Zichtbaar afzenderadres (default in config: info@gratisplanten.nl). Geen wachtwoord hier.
MAIL_FROM_ADDRESS=info@gratisplanten.nl
MAIL_FROM_NAME="${APP_NAME}"
# Optioneel override voor footer/privacy/contact (default = info@gratisplanten.nl).
# SITE_CONTACT_EMAIL=info@gratisplanten.nl

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SITE_NAME="Gratis planten"
# SITE_CONTACT_EMAIL=info@gratisplanten.nl
ADMIN_PASSWORD=
# Optioneel: mailbox voor beheer-meldingen (default = MAIL_FROM_ADDRESS).
ADMIN_EMAIL=
# Unieke account-e-mails (CSV) met Dashboard-menu + /beheer zonder apart wachtwoord.
# Leeg = val terug op ADMIN_EMAIL. Match alleen op users.email (nooit weergavenaam).
# ADMIN_DASHBOARD_EMAILS=
CRON_TOKEN=
# Staging cPanel-deploy: Bearer voor POST /deploy/run (leeg = uit).
DEPLOY_TOKEN=
# Optioneel: /deploy/run ook buiten APP_ENV=staging (default uit).
# DEPLOY_ENDPOINT_ENABLED=false
# Eenmalige dataverhuis: POST /deploy/import (default uit).
# Op prod: zet via deploy-prod-hook workflow_dispatch import_enabled=true|false
# (geen handmatige .env-edit; tag-pushes schrijven false).
# DEPLOY_IMPORT_ENABLED=false
# Canonieke productiehost (301 vanaf gratisstekjes.nl-aliases).
# CANONICAL_HOST=gratisplanten.nl
COORD_DECIMALS=3
MEEDOEN_TELLER_DREMPEL=25
FORM_MIN_SECONDS=3
GEOCODE_CACHE_RETENTION_DAYS=90
RATE_LIMIT_RETENTION_SECONDS=172800
PDOK_URL=https://api.pdok.nl/bzk/locatieserver/search/v3_1/free
# Nominatim (NL+BE); User-Agent bevat siteversie + contactmail.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOINDEX=false

# Nieuwe homepage (beeldrijk). Default uit — prod blijft oude homepage tot Joris ja zegt.
# Staging-deploy zet HOMEPAGE_V2=true. Op prod: secret/var HOMEPAGE_V2=true + deploy, of handmatig in .env.
# HOMEPAGE_V2=false
# Optioneel: hero-variant a|b|c|d (default b). Teksten in config/homepage.php.
# HOMEPAGE_HERO_VARIANT=b

# Ervaringen-blok op homepage (default uit).
# ERVARINGEN_HOME_BLOCK_ENABLED=false
# Felicitatiemail 'eerste stekje' (default UIT — pas aanzetten na akkoord Joris).
MILESTONE_MAIL_ENABLED=false

# Apart van APP_KEY; voor php artisan backup:database-encrypted (nooit committen).
# Zelfde waarde als GitHub secret BACKUP_ENCRYPTION_KEY (staging + production env).
# BACKUP_ENCRYPTION_KEY=
# Rolling bewaartermijn voor storage/backups/*.enc (dagen). Default 30.
# BACKUP_RETAIN_DAYS=30
